{
  "name": "litestation",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run --exclude=tests/cleancode/**",
    "test:cleancode": "node --experimental-strip-types --test tests/cleancode/*.test.ts",
    "lint:oxlint": "oxlint --config .oxlintrc.vue.json src/App.vue src/components/DatabaseTabs.vue src/components/WelcomeScreen.vue src/composables/useDatabaseSessions.ts src/services/launch.ts tests/composables/useDatabaseSessions.test.ts",
    "format:oxfmt": "oxfmt --check src/services/launch.ts src/composables/useDatabaseSessions.ts tests/composables/useDatabaseSessions.test.ts",
    "update-version": "python3 scripts/update-version.py",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "ag-grid-community": "^36.2.0",
    "ag-grid-vue3": "^36.2.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.1.10"
  }
}
